{
  "entities": {
    "User": {
      "title": "User",
      "description": "CRM Staff Member profile and role-based access control record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "hr_executive", "recruiter"] },
        "designation": { "type": "string" },
        "avatar": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role", "active"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Job seeker candidate record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "assignedRecruiterId": { "type": "string" },
        "assignedRecruiterName": { "type": "string" },
        "status": { "type": "string" },
        "lastEditReason": { "type": "string" }
      },
      "required": ["id", "fullName", "phone", "assignedRecruiterId", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Corporate client company record across Green, Blue, and Red sections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "section": { "type": "string", "enum": ["Green", "Blue", "Red"] },
        "status": { "type": "string" },
        "lastEditReason": { "type": "string" }
      },
      "required": ["id", "name", "city", "section"]
    },
    "JobOpening": {
      "title": "JobOpening",
      "description": "Client job mandate / opening",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "status": { "type": "string" },
        "lastEditReason": { "type": "string" }
      },
      "required": ["id", "title", "clientId", "clientName", "status"]
    },
    "PipelineItem": {
      "title": "PipelineItem",
      "description": "Candidate hiring pipeline stage record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "candidateId": { "type": "string" },
        "jobId": { "type": "string" },
        "stage": { "type": "string" },
        "assignedRecruiterId": { "type": "string" }
      },
      "required": ["id", "candidateId", "jobId", "stage", "assignedRecruiterId"]
    },
    "Interview": {
      "title": "Interview",
      "description": "Scheduled candidate interview record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "candidateId": { "type": "string" },
        "jobId": { "type": "string" },
        "assignedToRecruiterId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "candidateId", "assignedToRecruiterId", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Follow-up reminder or assigned task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "assignedToUserId": { "type": "string" },
        "assignedByUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed"] }
      },
      "required": ["id", "title", "assignedToUserId", "assignedByUserId", "status"]
    },
    "EditHistory": {
      "title": "EditHistory",
      "description": "Create-only audit trail of edits to candidates, clients, and jobs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityId": { "type": "string" },
        "entityType": { "type": "string", "enum": ["candidate", "client", "job"] },
        "reason": { "type": "string" }
      },
      "required": ["id", "entityId", "entityType", "reason"]
    },
    "Remark": {
      "title": "Remark",
      "description": "Create-only remark log for candidates and companies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityId": { "type": "string" },
        "text": { "type": "string" },
        "authorUserId": { "type": "string" }
      },
      "required": ["id", "text", "authorUserId"]
    },
    "Trash": {
      "title": "Trash",
      "description": "Soft-deleted records archive managed by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" }
      },
      "required": ["id", "entityType", "entityId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "CRM users collection"
    },
    "/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/Candidate" },
      "description": "Candidates collection"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Client companies collection"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/JobOpening" },
      "description": "Open job mandates collection"
    },
    "/pipeline/{pipelineId}": {
      "schema": { "$ref": "#/entities/PipelineItem" },
      "description": "Recruitment pipeline items"
    },
    "/interviews/{interviewId}": {
      "schema": { "$ref": "#/entities/Interview" },
      "description": "Interviews collection"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Assigned tasks and reminders"
    },
    "/editHistory/{historyId}": {
      "schema": { "$ref": "#/entities/EditHistory" },
      "description": "Immutable edit history logs"
    },
    "/remarks/{remarkId}": {
      "schema": { "$ref": "#/entities/Remark" },
      "description": "Immutable remarks collection"
    },
    "/trash/{trashId}": {
      "schema": { "$ref": "#/entities/Trash" },
      "description": "Deleted records archive (Admin only)"
    }
  }
}
