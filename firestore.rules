rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isInitialAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (request.auth.token.email.lower() == 'praveenverma1420@gmail.com' ||
         request.auth.token.email.lower() == 'admin@bjbright.com');
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Only signed-in users whose users/{uid} has active == true can read or write
    function isActiveUser() {
      return isSignedIn() &&
        userDocExists() &&
        currentUserData().active == true;
    }

    function hasRole(roleName) {
      return isActiveUser() && currentUserData().role == roleName;
    }

    function isAdmin() {
      return hasRole('admin') || (isInitialAdminEmail() && (!userDocExists() || currentUserData().active == true));
    }

    function isAdminOrManager() {
      return isAdmin() || hasRole('manager');
    }

    function canWriteCompanies() {
      return isAdmin() || hasRole('manager') || hasRole('hr_executive');
    }

    function hasNonEmptyEditReason() {
      return request.resource.data.lastEditReason is string &&
        request.resource.data.lastEditReason.trim().size() > 0;
    }

    function isValidCandidateStatus() {
      return !('status' in request.resource.data) ||
        request.resource.data.status in [
          'New',
          'Screened',
          'Shortlisted',
          'Interview Scheduled',
          'Selected',
          'Offered',
          'Placed',
          'Rejected',
          'On Hold'
        ];
    }

    function isValidPipelineStage() {
      return !('stage' in request.resource.data) ||
        request.resource.data.stage in [
          'Sourced',
          'Screened',
          'Submitted to Client',
          'Interview',
          'Offer',
          'Placed',
          'Rejected'
        ];
    }

    // ==================== CONNECTION TEST ====================
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ==================== USERS COLLECTION ====================
    match /users/{uid} {
      // Signed-in user can read their own profile to check active status; active users can read team list
      allow get: if (isSignedIn() && request.auth.uid == uid) || isActiveUser();
      allow list: if isActiveUser();

      // Initial Admin can bootstrap their own users/{uid} with role == 'admin'; otherwise only Admin can write users
      allow create: if (isInitialAdminEmail() &&
                        request.auth.uid == uid &&
                        request.resource.data.role == 'admin' &&
                        request.resource.data.active == true) ||
                    isAdmin();

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==================== CANDIDATES COLLECTION ====================
    match /candidates/{candidateId} {
      // Admin & Manager read all; Recruiter & HR read only records assigned to them
      allow read: if isActiveUser() && (
        isAdminOrManager() ||
        resource.data.assignedRecruiterId == request.auth.uid
      );

      // entryDate (server time) and enteredBy are written on create
      allow create: if isActiveUser() &&
        isValidCandidateStatus() &&
        'entryDate' in request.resource.data &&
        (request.resource.data.entryDate == request.time || isAdmin()) &&
        'enteredBy' in request.resource.data &&
        request.resource.data.enteredBy is string &&
        request.resource.data.enteredBy.trim().size() > 0 && (
          isAdminOrManager() ||
          request.resource.data.assignedRecruiterId == request.auth.uid
        );

      // Edits to candidates must include a non-empty edit reason; entryDate & enteredBy cannot be changed unless Admin
      allow update: if isActiveUser() &&
        isValidCandidateStatus() &&
        hasNonEmptyEditReason() &&
        (isAdmin() || (
          (!('entryDate' in request.resource.data) ||
           ('entryDate' in resource.data && request.resource.data.entryDate == resource.data.entryDate)) &&
          (!('enteredBy' in request.resource.data) ||
           ('enteredBy' in resource.data && request.resource.data.enteredBy == resource.data.enteredBy))
        )) && (
          isAdminOrManager() ||
          resource.data.assignedRecruiterId == request.auth.uid
        );

      // Only Admin can delete anything
      allow delete: if isAdmin();
    }

    // ==================== CLIENTS (COMPANIES) COLLECTION ====================
    match /clients/{clientId} {
      // All active roles can read/search all companies
      allow read: if isActiveUser();

      // Company writes only by Admin, Manager and HR Executive
      allow create: if canWriteCompanies();

      // Edits to companies must include a non-empty edit reason
      allow update: if canWriteCompanies() && hasNonEmptyEditReason();

      // Only Admin can delete anything
      allow delete: if isAdmin();
    }

    // ==================== JOBS COLLECTION ====================
    match /jobs/{jobId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();

      // Edits to jobs must include a non-empty edit reason
      allow update: if isActiveUser() && hasNonEmptyEditReason();

      // Only Admin can delete anything
      allow delete: if isAdmin();
    }

    // ==================== PIPELINE COLLECTION ====================
    match /pipeline/{pipelineId} {
      // Admin & Manager read all; Recruiter & HR read only records assigned to them
      allow read: if isActiveUser() && (
        isAdminOrManager() ||
        resource.data.assignedRecruiterId == request.auth.uid
      );

      allow create: if isActiveUser() &&
        isValidPipelineStage() && (
          isAdminOrManager() ||
          request.resource.data.assignedRecruiterId == request.auth.uid
        );

      allow update: if isActiveUser() &&
        isValidPipelineStage() && (
          isAdminOrManager() ||
          resource.data.assignedRecruiterId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // ==================== INTERVIEWS COLLECTION ====================
    match /interviews/{interviewId} {
      // Admin & Manager read all; Recruiter & HR read only records assigned to them
      allow read: if isActiveUser() && (
        isAdminOrManager() ||
        resource.data.assignedToRecruiterId == request.auth.uid
      );

      allow create: if isActiveUser() && (
        isAdminOrManager() ||
        request.resource.data.assignedToRecruiterId == request.auth.uid
      );

      allow update: if isActiveUser() && (
        isAdminOrManager() ||
        resource.data.assignedToRecruiterId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ==================== TASKS COLLECTION ====================
    match /tasks/{taskId} {
      // Admin & Manager read all; Recruiter & HR read only records assigned to them (or created by HR)
      allow read: if isActiveUser() && (
        isAdminOrManager() ||
        resource.data.assignedToUserId == request.auth.uid ||
        (hasRole('hr_executive') && resource.data.createdByUserId == request.auth.uid)
      );

      // Task creation only by Admin and HR Executive (HR only for recruiters)
      allow create: if isAdmin() || (
        hasRole('hr_executive') &&
        request.resource.data.assignedToUserId is string &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.assignedToUserId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.assignedToUserId)).data.role == 'recruiter'
      );

      allow update: if isAdmin() ||
        (isActiveUser() && resource.data.assignedToUserId == request.auth.uid) ||
        (hasRole('hr_executive') && resource.data.createdByUserId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ==================== EDIT HISTORY (CREATE-ONLY) ====================
    match /editHistory/{historyId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() &&
        request.resource.data.reason is string &&
        request.resource.data.reason.trim().size() > 0;
      allow update, delete: if false;
    }

    // ==================== REMARKS (CREATE-ONLY; ADMIN MIGRATION UPDATE) ====================
    match /remarks/{remarkId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() &&
        request.resource.data.text is string &&
        request.resource.data.text.trim().size() > 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==================== TRASH COLLECTION (ADMIN ONLY) ====================
    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    // ==================== SETTINGS COLLECTION ====================
    match /settings/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
