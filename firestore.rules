rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated and active/authorized
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().active == true;
    }

    function isManager() {
      return isAuthenticated() && (getUserData().role == 'manager' || isAdmin()) && getUserData().active == true;
    }

    function isHrExecutive() {
      return isAuthenticated() && (getUserData().role == 'hr_executive' || isManager()) && getUserData().active == true;
    }

    function isRecruiter() {
      return isAuthenticated() && getUserData().active == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Candidates collection
    match /candidates/{candidateId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        resource.data.assignedRecruiterId == request.auth.uid
      );
      allow create: if isAuthenticated() && isRecruiter();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        (resource.data.assignedRecruiterId == request.auth.uid && request.resource.data.editReason is string && request.resource.data.editReason.size() >= 10)
      );
      allow delete: if isAdmin();
    }

    // Clients collection (all active users may read; Admin, Manager & HR Executive may create or update; only Admin may delete)
    match /clients/{clientId} {
      allow read: if isAuthenticated() && isRecruiter();
      allow create, update: if isHrExecutive();
      allow delete: if isAdmin();

      match /remarks/{remarkId} {
        allow read: if isAuthenticated() && isRecruiter();
        allow create: if isHrExecutive() &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 3 &&
          request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // Job Openings collection
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isManager();
      allow update: if isAuthenticated() && (isAdmin() || isManager());
      allow delete: if isAdmin();
    }

    // Tasks / Reminders collection
    match /reminders/{reminderId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (getUserData().role == 'hr_executive' && (resource.data.assignedToUserId == request.auth.uid || resource.data.assignedByUserId == request.auth.uid)) ||
        resource.data.assignedToUserId == request.auth.uid
      );
      allow create: if isAdmin() || (isAuthenticated() && getUserData().role == 'hr_executive' && getUserData().active == true);
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (getUserData().role == 'hr_executive' && resource.data.assignedByUserId == request.auth.uid) ||
        resource.data.assignedToUserId == request.auth.uid
      );
      allow delete: if isAdmin() || (isAuthenticated() && getUserData().role == 'hr_executive' && resource.data.assignedByUserId == request.auth.uid);
    }

    // Activity Log & Edit History
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /editHistories/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
